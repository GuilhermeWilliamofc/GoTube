{
  "name": "gotube",
  "version": "1.0.0",
  "description": "O **goTube** é um player e organizador de biblioteca de mídia local focado em oferecer uma experiência fluida de streaming offline. Todo o conteúdo é gerenciado localmente, construindo automaticamente feed, categorização por tags e recomendações inteligentes.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "fix-download": "python -m pip install --upgrade pytubefix",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.gotube.app",
    "productName": "goTube",
    "win": {
      "target": "portable",
      "icon": "app/assets/icon.png"
    },
    "asar": true,
    "asarUnpack": [
      "app/scripts/**/*"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1"
  }
}
